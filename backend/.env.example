# Copy to backend/.env (git-ignored). Variables already set in the environment win.
DATABASE_URL=postgresql+psycopg://studio:studio@127.0.0.1:55433/studio
ALLOWED_ORIGINS=["http://localhost:3000"]
# Set to true behind HTTPS so the session cookie is never sent in clear text.
COOKIE_SECURE=false
# Encrypts stored OAuth tokens; connections are off without it. Generate with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEYS=
# A GitHub OAuth app; callback URL http://localhost:3000/api/connections/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# The local test provider (devtools/oauth_provider.py), started with the same secret.
# DEV_OAUTH_URL=http://127.0.0.1:8010
# DEV_OAUTH_CLIENT_SECRET=
# Optional: lets "llm" nodes call OpenAI.
# OPENAI_API_KEY=
